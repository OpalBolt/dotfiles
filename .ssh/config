Host *
    ServerAliveInterval 30
    ServerAliveCountMax 3
    AddKeysToAgent yes
    HashKnownHosts yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    # Agent forwarding is off by default. Enable it per host:
    #   Host myserver
    #       ForwardAgent yes
    ForwardAgent no
