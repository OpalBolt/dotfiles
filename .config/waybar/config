[
  {
    // -- Bar --------------------------------------------------
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 0,

    // -- Layout -----------------------------------------------
    "modules-left": [
      "mango/workspaces",
      "mango/layout",
      "mango/window"
    ],
    "modules-center": ["clock#default", "mpris"],
    "modules-right": [
      "bluetooth",
      "custom/bt-separator",
      "pulseaudio",
      "custom/separator",
      "network",
      "custom/separator",
      "backlight",
      "custom/separator",
      "battery",
      "custom/separator",
      "mango/language",
      "mango/keymode",
      "custom/separator",
      "idle_inhibitor",
      "custom/separator",
      "custom/notifications",
      "custom/separator",
      "custom/kernel",
      "custom/separator",
      "tray"
    ],


    // -- Left -----------------------------------------------
    "mango/workspaces": {
      "format": "{icon}",
      "hide-empty": false,
      "on-click": "activate",
      "on-click-right": "toggle",
      "overview-label": "OVERVIEW",
    },
    "mango/keymode": {
        "format": "{}",
        // "format-default": " Default",
        // "format-test": " Test",
    },
    "mango/window": {
        "format": "{}",
            "icon-size": 20
    },
    "mango/layout": {
            "format": "{}",
            // "format-S": "Scroller",
            // "format-T": "Tile",
    },
        "mango/language": {
        "format": "{short}",
    },

    // -- Center -----------------------------------------------
    "clock#default": {
      "format": "{:%H:%M 󰥔 }",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "mpris": {
      "format": "|  {status_icon} {artist} • {title}",
      "status-icons": {
        "playing": "󰐊 ",
        "paused": "󰏤 ",
        "stopped": "󰓛 "
      },
      "artist-len": 25,
      "title-len": 35,
      "on-click": "playerctl play-pause",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous",
      "tooltip-format": "{player}: {artist} - {title}"
    },

    // -- Right ------------------------------------------------
    "bluetooth": {
      "format": "",
      "format-disabled": "",
      "format-off": "",
      "format-on": "",
      "format-connected": " {device_alias}",
      "format-connected-battery": " {device_alias} {device_battery_percentage}%",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "mmsg dispatch toggle_named_scratchpad,mango-bluetooth,none,wezterm start --class mango-bluetooth -e bluetui"
    },
    "pulseaudio": {
      "format": "{volume}% {icon}",
      "format-bluetooth": "{volume}% {icon}",
      "format-muted": " ",
      "format-icons": {
        "headphones": " ",
        "handsfree": " ",
        "headset": " ",
        "phone": " ",
        "portable": " ",
        "car": " ",
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol"
    },
    "network": {
      "format-alt": "{ifname}: {ipaddr}/{cidr}",
      "format-disconnected": "Disconnected ⚠",
      "format-ethernet": "{ipaddr}/{cidr} 󰈁",
      "format-linked": "{ifname} (No IP) 󰈂",
      "format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format": "{gwaddr} via {ifname} 󰈀 "
    },
    "backlight": {
      "format": "{icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
      "bat": "BAT1",
      "interval": 30,
      "states": {
        "warning": 20,
        "critical": 10
      },
      "format": "{icon}",
      "format-charging": "{capacity}% 󱐋",
      "format-warning": "{capacity}% {icon}",
      "format-critical": "{capacity}% {icon}",
      "format-icons": ["", "", "", "", ""]
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰅶",
        "deactivated": "󰛊"
      }
    },
    "custom/notifications": {
      "exec": "$HOME/.config/waybar/notifications.sh",
      "on-click": "$HOME/.config/waybar/notifications.sh toggle",
      "return-type": "json",
      "format": "{}",
      "interval": "once",
      "signal": 8,
      "tooltip": true
    },
    "custom/kernel": {
      "exec": "$HOME/.config/waybar/icon.sh",
      "return-type": "json",
      "format": "{}",
      "tooltip": true
    },
    "custom/bt-separator": {
      "exec": "$HOME/.config/waybar/bt-separator.sh",
      "interval": 5,
      "tooltip": false
    },
    "custom/separator": {
      "format": "|",
      "interval": "once",
      "tooltip": false
    },
    "tray": {
      "spacing": 5
    }
  }
]
