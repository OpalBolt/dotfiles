[
  {
    "backlight": {
      "format": "{icon}",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ]
    },
    "battery": {
        "bat": "BAT1",
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}",
        "format-charging": "{capacity}% 󱐋",
        "format-warning": "{capacity}% {icon}",
        "format-critical": "{capacity}% {icon}",
        "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
    },
    "clock#default": {
      "format": "{:%H:%M 󰥔 }",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },
    "custom/kernel": {
      "exec": "$HOME/.config/waybar/icon.sh",
      "return-type": "json",
      "format": "{}",
      "tooltip": true,
      // "tooltip-format": "echo \"󰣇 $(uname -r)\"",
    },
    "height": 0,
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰅶",
        "deactivated": "󰛊"
      }
    },
    "niri/language": {
      "format": "{short}  "
    },

    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },
    "layer": "top",
    "modules-center": [
      "clock#default",
        ],
    "modules-left": [
      "niri/workspaces",
    ],
    "modules-right": [
      "pulseaudio",
      "custom/separator",
      "network",
      "custom/separator",
      "backlight",
      "custom/separator",
      "battery",
      "custom/separator",
      "niri/language",
      "custom/separator",
      "language",
      "idle_inhibitor",
      "custom/separator",
      "custom/kernel",
      "custom/separator",
      "tray"
    ],
    "network": {
      "format-alt": "{ifname}: {ipaddr}/{cidr}",
      "format-disconnected": "Disconnected ⚠",
      "format-ethernet": "{ipaddr}/{cidr} 󰈁",
      "format-linked": "{ifname} (No IP) 󰈂",
      "format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format": "{gwaddr} via {ifname} 󰈀 "
    },
    "position": "top",

    "pulseaudio": {
        //"scroll-step": 1,
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ],
        },
        "on-click": "pavucontrol"
    },

    "spacing": 1,
    "tray": {
      "spacing": 5
    }
  }
]
