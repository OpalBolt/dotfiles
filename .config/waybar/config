[
  {
    // -- Bar --------------------------------------------------
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 1,

    // -- Layout -----------------------------------------------
    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock#default", "mpris"],
    "modules-right": [
      "pulseaudio",
      "custom/separator",
      "network",
      "custom/separator",
      "backlight",
      "custom/separator",
      "battery",
      "custom/separator",
      "niri/language",
      "custom/separator",
      "idle_inhibitor",
      "custom/separator",
      "custom/kernel",
      "custom/separator",
      "tray"
    ],

    // -- Center -----------------------------------------------
    "clock#default": {
      "format": "{:%H:%M 󰥔 }",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "mpris": {
      "format": "|  {status_icon} {artist} • {title}",
      "status-icons": {
        "playing": "󰐊 ",
        "paused": "󰏤 ",
        "stopped": "󰓛 "
      },
      "artist-len": 25,
      "title-len": 35,
      "on-click": "playerctl play-pause",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous",
      "tooltip-format": "{player}: {artist} - {title}"
    },

    // -- Right ------------------------------------------------
    "pulseaudio": {
      "format": "{volume}% {icon}",
      "format-bluetooth": "{volume}% {icon}",
      "format-muted": "",
      "format-icons": {
        "headphones": "",
        "handsfree": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol"
    },
    "network": {
      "format-alt": "{ifname}: {ipaddr}/{cidr}",
      "format-disconnected": "Disconnected ⚠",
      "format-ethernet": "{ipaddr}/{cidr} 󰈁",
      "format-linked": "{ifname} (No IP) 󰈂",
      "format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format": "{gwaddr} via {ifname} 󰈀 "
    },
    "backlight": {
      "format": "{icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
      "bat": "BAT1",
      "interval": 30,
      "states": {
        "warning": 20,
        "critical": 10
      },
      "format": "{icon}",
      "format-charging": "{capacity}% 󱐋",
      "format-warning": "{capacity}% {icon}",
      "format-critical": "{capacity}% {icon}",
      "format-icons": ["", "", "", "", ""]
    },
    "niri/language": {
      "format": "{short}  "
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰅶",
        "deactivated": "󰛊"
      }
    },
    "custom/kernel": {
      "exec": "$HOME/.config/waybar/icon.sh",
      "return-type": "json",
      "format": "{}",
      "tooltip": true
    },
    "custom/separator": {
      "format": "|",
      "interval": "once",
      "tooltip": false
    },
    "tray": {
      "spacing": 5
    }
  }
]
