#!/usr/bin/env bash
# hag — launch a coding agent under nono, staying visible to Herdr's Agents panel.
#
# Usage: hag [harness] [harness-args...] -- [nono-flags...]
#   hag                                     # menu, then plain launch
#   hag --resume                            # menu; --resume queued for the pick
#   hag pi                                  # plain launch
#   hag pi --resume -- --allow /mnt/videos  # pi args left of --, nono flags right
#   NONO_ALLOW=/x hag pi                    # nono env vars pass through too
#
# Herdr reads HERDR_AGENT from the pane's *foreground* process — from its
# /proc/<pid>/environ, which is the snapshot taken at exec time. Under plain
# `nono run` the foreground process is nono's hardened supervisor (environ
# unreadable), and an `export` inside a wrapper bash never lands in that
# snapshot either; either way the hint is lost (agent shows as "unknown" and
# drops off the panel after ~30s). Fix: exec into `env HERDR_AGENT=… sh -c
# '…; exit $code'` so a plain shell carries the hint from exec time and stays
# foreground for the whole session. The trailing `exit` is load-bearing — it
# keeps nono's own exit code the pane's. nono still owns all sandbox
# enforcement.
# Refs: https://herdr.dev/tui/docs/agents/ and nolabs-ai/nono#2107

# `set -e` is deliberately absent: several helpers (find_line, repo_is_enrolled)
# report failure through their exit status and are called in an `if`.
set -u

# The registry: one line per harness, five pipe-separated fields:
#
#   name | Herdr agent kind | nono profile | command | menu label
#
# Adding a harness means adding a line here; everything below reads these
# fields. Kinds must match Herdr's supported list (`herdr agent start --kind`).
# vibe has no Herdr manifest yet (harmless; lights up when Herdr adds one)
# and no dedicated nono profile, so it runs on the conservative default.
registry=(
	'pi|pi|pi|pi|🥧 Pi Coding Agent'
	'opencode|opencode|opencode|opencode|💻 OpenCode'
	'copilot|copilot|copilot|copilot|🤖 GitHub Copilot CLI'
	'claude|claude|claude|claude|✨ Claude Code'
	'vibe|vibe|default|vibe|🌊 Mistral Vibe (no Herdr manifest yet)'
)

# The five fields of one registry line. Bash has no tuples, so split_line
# unpacks a line into these globals instead of returning them.
harness_name=''
harness_kind=''
harness_profile=''
harness_command=''
harness_label=''

# split_line <registry line> — unpacks one registry line into the five fields.
split_line() {
	IFS='|' read -r harness_name harness_kind harness_profile harness_command harness_label <<<"$1"
}

# find_line <harness name> — prints that harness's registry line and succeeds.
# Prints nothing and fails when no line carries the name.
find_line() {
	local wanted=$1 line
	for line in "${registry[@]}"; do
		split_line "$line"
		if [[ $harness_name == "$wanted" ]]; then
			printf '%s\n' "$line"
			return 0
		fi
	done
	return 1
}

# print_menu — the fzf input: the harness name padded to 8 columns, then its
# menu label. The padding is hand-made because fzf renders tabs as fixed
# spaces, not tab stops, which leaves the label column ragged.
print_menu() {
	local line
	for line in "${registry[@]}"; do
		split_line "$line"
		printf '%-8s  %s\n' "$harness_name" "$harness_label"
	done
}

# repo_is_enrolled <repo dir> — the two Gate facts hag checks before it spends
# a permint line: an origin remote on github.com, and a `token source: permint`
# line in the repo's .scratch/projectinfo.md. permint re-checks both.
repo_is_enrolled() {
	local repo=$1 origin
	origin=$(git -C "$repo" remote get-url origin 2>/dev/null)
	case $origin in
	*github.com*) ;;
	*) return 1 ;;
	esac
	grep -qs '^token source:[[:space:]]*permint' "$repo/.scratch/projectinfo.md" || return 1
	return 0
}

# Pick the harness. A bare `hag`, or a leading flag or `--` (`hag --resume`,
# `hag -- --allow /x`), opens the menu with the arguments still queued. A
# leading word must name a known harness, so a typo fails here instead of
# reaching the menu.
if [[ $# -eq 0 ]] || [[ $1 == -* ]]; then
	if ! command -v fzf >/dev/null; then
		echo 'hag: fzf not found' >&2
		exit 1
	fi
	choice=$(print_menu | fzf --prompt='harness ❯ ' --pointer='▸' \
		--header='agent args before -- · nono flags after -- · NONO_* env passes through' \
		--height=35%) || exit $?
	# A menu row is "name<two spaces>label"; only the name matters here.
	read -r name _ <<<"$choice"
else
	name=$1
	shift
fi

if ! harness_line=$(find_line "$name"); then
	names=''
	for line in "${registry[@]}"; do
		split_line "$line"
		if [[ -n $names ]]; then
			names="$names, "
		fi
		names="$names$harness_name"
	done
	echo "hag: unknown harness '$name' (expected one of: $names)" >&2
	exit 1
fi
split_line "$harness_line"

# The first `--` belongs to hag: the arguments left of it reach the harness
# verbatim, and the arguments right of it are spliced in as nono flags.
# shortcut: a harness argument that is itself a bare `--` cannot be passed;
# add an opt-out flag here if that ever matters.
harness_args=()
nono_flags=()
past_separator=0
for arg in "$@"; do
	if [[ $past_separator -eq 1 ]]; then
		nono_flags+=("$arg")
	elif [[ $arg == -- ]]; then
		past_separator=1
	else
		harness_args+=("$arg")
	fi
done

# Resolve the harness command to a concrete path here, in the outer shell, so
# PATH differences inside the sandbox cannot matter.
bin=$(command -v "$harness_command")
if [[ -z $bin ]]; then
	echo "hag: '$harness_command' not found on PATH" >&2
	exit 1
fi

# permint: one GitHub Session token for the agent, when this repo is enrolled.
# The two Gate facts are cheap to read here, so every other launch skips the
# binary instead of spending a closed-gate line on it; permint re-checks both
# and owns the mint. A failed mint is permint's one stderr line and a tokenless
# launch — no Grant, and the harness still starts, as permint's contract wants.
repo=$(git rev-parse --show-toplevel 2>/dev/null)
grant=''
permint_pid=''
if [[ -n $repo ]] && command -v permint >/dev/null && repo_is_enrolled "$repo"; then
	grant=$(permint session-start "$$" "$repo")
	if [[ -n $grant ]]; then
		# The stop runs after nono exits, still under this pid.
		permint_pid=$$
		session_dir=$(dirname "$grant")
		# permint's sandbox contract: the Grant, its expiry, and the Refresher
		# pid, one file at a time — never the session dir (it holds every other
		# Session's token) and never refresher.log. PERMINT_GRANT below lets the
		# agent ask permint about its own Session from inside the sandbox.
		nono_flags+=(
			--read-file "$grant"
			--read-file "$session_dir/expiry"
			--read-file "$session_dir/refresher.pid"
		)
	fi
fi

# exec, not export: Herdr re-reads /proc/<pid>/environ on every probe, and that
# file only holds the variables present at exec time. Everything after -p is
# flattened into one "$@": the nono flags, the separator, then the resolved
# harness and its arguments.
# PERMINT_PID is set only when a mint succeeded, so the stop runs on exactly
# the launches that own a Session — and it holds this same pid, since exec
# keeps the pid nono runs under.
# The sh body sticks to POSIX `[ ]`: sh may be dash, which has no `[[ ]]`.
# shellcheck disable=SC2016 # $0/$@/$$ expand inside sh, not in hag's shell
exec env HERDR_AGENT="$harness_kind" PERMINT_PID="$permint_pid" PERMINT_GRANT="$grant" \
	sh -c '
		nono run -p "$0" --allow-cwd "$@"
		code=$?
		if [ -n "${PERMINT_PID:-}" ]; then
			permint session-stop "$PERMINT_PID"
		fi
		exit $code
	' "$harness_profile" "${nono_flags[@]}" -- "$bin" "${harness_args[@]}"
