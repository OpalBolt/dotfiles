#!/usr/bin/env bash
# sysupdate — update Arch, and never leave the ESP without a bootable kernel.
#
#   ./sysupdate            # pre-flight, update, verify, refresh rescue image
#   ./sysupdate --check    # pre-flight + verify only, changes nothing
#   ./sysupdate --force    # skip the free-space gate
#
# Why: a failed pacman transaction skips its post-transaction hooks, and
# 60-mkinitcpio-remove already deleted the UKI in the pre-transaction hook.
# That is how the 2026-11-18 boot failure happened.

set -uo pipefail

MIN_FREE_G=3
ESP=/boot
UKI=$ESP/EFI/Linux/arch-linux.efi
RESCUE=$ESP/EFI/Linux/rescue.efi
RESCUE_PREV=$ESP/EFI/Linux/rescue-prev.efi

# pacman needs root; re-exec once so every check can read root-only paths
if ((EUID != 0)); then
	exec sudo -- bash "$0" "$@"
fi

mode=update
for arg in "$@"; do
	case $arg in
	--check) mode=check ;;
	--force) mode=force ;;
	*)
		echo "unknown argument: $arg" >&2
		exit 2
		;;
	esac
done

say() { printf '\n==> %s\n' "$*"; }
warn() { printf '!!  %s\n' "$*" >&2; }

root_free_g() {
	if btrfs filesystem usage -b / >/dev/null 2>&1; then
		btrfs filesystem usage -b / | awk '/Free \(estimated\):/ { printf "%d\n", $3 / 1073741824 }'
	else
		df -BG --output=avail / | tail -1 | tr -dc 0-9
	fi
}

# installed kernel version, in bootctl's spelling (7.3.5.arch1-1 -> 7.3.5-arch1-1)
kernel_want() {
	pacman -Q linux 2>/dev/null | awk '{ print $2 }' | sed 's/\.arch/-arch/'
}

uki_matches() {
	bootctl list --no-pager 2>/dev/null | grep -q "uname: $1\$"
}

preflight() {
	local free
	if ! findmnt -no SOURCE "$ESP" >/dev/null; then
		warn "$ESP is not a mounted filesystem — refusing to update (would write to the root fs)."
		return 1
	fi
	free=$(root_free_g)
	if [[ $free =~ ^[0-9]+$ ]] && ((free < MIN_FREE_G)); then
		warn "root filesystem has only ${free}G free, want ${MIN_FREE_G}G+."
		if command -v docker >/dev/null; then
			say "docker disk usage"
			docker system df 2>/dev/null | sed 's/^/    /'
		fi
		if command -v snapper >/dev/null; then
			say "last snapshots"
			snapper list 2>/dev/null | tail -5 | sed 's/^/    /'
		fi
		if [[ $mode != force ]]; then
			echo
			warn "free space first, or re-run with --force (a full disk is what broke the last update)."
			return 1
		fi
	fi
	say "root free: ${free:-?}G, ESP free: $(df -h --output=avail "$ESP" | tail -1 | tr -d ' ')"
	return 0
}

verify() {
	local want ok=1
	want=$(kernel_want)
	[[ -n $want ]] || {
		warn "cannot read installed linux version"
		return 1
	}

	if [[ ! -s $UKI ]]; then
		warn "no boot image at $UKI"
		ok=0
	elif ! uki_matches "$want"; then
		warn "boot image on the ESP is not kernel $want"
		ok=0
	fi

	if ((! ok)) && [[ $mode != check ]]; then
		say "rebuilding initramfs (mkinitcpio -P)"
		mkinitcpio -P || warn "mkinitcpio failed — do NOT reboot"
		if [[ -s $UKI ]] && uki_matches "$want"; then
			ok=1
		else
			warn "still no matching boot image for $want — do NOT reboot"
		fi
	fi
	((ok))
}

refresh_rescue() {
	local esp_free
	esp_free=$(df -B1 --output=avail "$ESP" | tail -1 | tr -dc 0-9)
	if ((${esp_free:-0} < 120 * 1024 * 1024)); then
		warn "ESP nearly full, not refreshing $RESCUE"
		return
	fi
	[[ -f $RESCUE ]] && cp -f "$RESCUE" "$RESCUE_PREV"
	cp -f "$UKI" "$RESCUE"
	say "rescue image refreshed: $RESCUE (previous: $RESCUE_PREV)"
}

report() {
	say "boot entries"
	bootctl list --no-pager 2>/dev/null | grep -E 'title:|uname:' | sed 's/^ */    /'
	echo
	echo "    If 'Arch Linux' with kernel $(kernel_want) is not above, do NOT reboot:"
	echo "    run 'mkinitcpio -P' and check 'bootctl list' again."
}

say "pre-flight"
preflight || exit 1

if [[ $mode == check ]]; then
	say "verifying boot image (no changes)"
	if verify; then say "OK: ESP matches installed kernel"; else exit 1; fi
	report
	exit 0
fi

say "updating"
pacman -Syu
rc=$?

if ((rc != 0)); then
	warn "pacman exited $rc (transaction failed?) — rebuilding initramfs as a safety net"
fi

say "verifying boot image"
verify || {
	report
	exit 1
}

[[ $rc -eq 0 ]] && refresh_rescue
report
exit "$rc"
